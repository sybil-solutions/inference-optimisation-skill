{
 "name": "mtp3",
 "base_url": "http://127.0.0.1:8000",
 "model": "dgx-current",
 "api_key_file": "~/.vllm-api-key",
 "stop": [
  "bash",
  "scripts/srv.sh",
  "stop"
 ],
 "health_timeout_s": 1500,
 "concurrency": 2,
 "prefill_lengths": [
  4096,
  32768
 ],
 "temperature": 1.0,
 "extra_body": {
  "top_p": 0.95,
  "top_k": 20
 },
 "memory": {
  "cap_gib": 253,
  "probe": [
   "bash",
   "scripts/hostmem.sh"
  ],
  "interval_s": 5
 },
 "launch": [
  "bash",
  "scripts/srv.sh",
  "start",
  "--speculative-config",
  "{\"method\":\"mtp\",\"num_speculative_tokens\":3}"
 ],
 "alive": [
  "bash",
  "scripts/srv.sh",
  "alive"
 ]
}